{
  "mcpServers": {
    "gitlab": {
      "command": "glab",
      "args": ["mcp", "serve"],
      "env": { "GITLAB_HOST": "<gitlab-host>" }
    },
    "jira": {
      "command": "uvx",
      "args": ["--from", "mcp-atlassian", "python", "-c", "import sys;from mcp_atlassian import main;sys.exit(main())"],
      "env": { "JIRA_URL": "<jira-url>" }
    }
  }
}

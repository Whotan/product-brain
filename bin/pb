#!/usr/bin/env python3
"""pb — Product Brain hub CLI.

Usage:
  pb sync [--dry-run] [--rebuild] [--provider NAME] [--hub PATH]
  pb adopt <local-checkout> [--id ID] [--copy] [--hub PATH]
  pb status [--hub PATH]
  pb check [--hook] [--hub PATH]
  pb find <term> [aliases...] [--hub PATH]
  pb version [--check]
  pb --help

`pb adopt` is a one-time migration: it relocates an existing local checkout into the hub's
repos/<id> folder (keeping git history, remote, and uncommitted work) so you work in the hub
from then on — a single copy, no drift.

Provider: graphify's doc/image pass uses an LLM. Pick it with --provider
(gemini | claude | openai | kimi | deepseek | ollama | auto) or in brain.config.json
("graph": {"provider": "gemini"}). Set the matching key, e.g. export GEMINI_API_KEY=...

The hub is your workspace: each app is cloned into repos/<id> as a FULL working clone, and
developers work in it directly — alongside the constitution, specs, vocabulary, and graph.

`pb sync` builds one knowledge graph over your hub's docs + those working clones:
  1. read brain.config.json
  2. pull the hub's own latest changes (safe: only if git repo + upstream + clean tree)
  3. clone each app into repos/<id> (full clone); existing clones are pulled only when safe
     (clean tree, fast-forward) so your uncommitted work is never disturbed. Per repo you can
     set "branch" (which branch to clone / switch a clean clone to) and "pull": false (never
     auto-pull that clone) in brain.config.json
  4. keep repos/ and graph/ out of the hub's Git via .git/info/exclude (not .gitignore, so
     graphify still reads repos/); write .gitignore entries for graphify's AST cache
     (graphify-out/) and .work/ — safe in a tracked .gitignore since they are never source
     input; and write a .graphifyignore so graphify skips its own output directories
  5. run graphify over the hub into the graph/ folder (incremental via cache)
  6. write graph/sync-report.md
  7. create/refresh the hub's README.md (managed block, from brain.config.json) — see --no-readme

No third-party Python packages required. Needs `git` and `graphify` on PATH
(`pip install graphifyy`).
"""

import argparse
import datetime as dt
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

CORE_DOCS = ["constitution.md", "vocabulary.md", "DESIGN.md", "domains.md"]

# The hub layout (checked by `pb check`). The top level is closed: only these files and folders,
# plus dot-entries (.claude/, .mcp.json, .gitignore, … — tooling, always allowed) and the repos +
# graph folders from brain.config.json. Team content goes under docs/<registered doc type>/.
ROOT_FILES = set(CORE_DOCS) | {"brain.config.json", "CLAUDE.md", "README.md"}
ROOT_DIRS = {"docs", "workflows", "templates"}
REQUIRED_DOC_TYPES = ["knowledge"]

README_START = "<!-- product-brain:managed:start -->"
README_END = "<!-- product-brain:managed:end -->"
# Signatures of a git-host default README (safe to replace — it's boilerplate, not the team's).
HOST_README_SIGNS = (
    "Getting started with GitLab",
    "makeareadme.com",
    "git push -uf origin",
    "## Add your files",
    "## Integrate with your tools",
)

# graphify picks its LLM provider (for the doc/image semantic pass) from env vars.
# We map a friendly provider name to the env var(s) graphify looks for.
PROVIDER_ENV = {
    "gemini":    ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
    "claude":    ["ANTHROPIC_API_KEY"],
    "anthropic": ["ANTHROPIC_API_KEY"],
    "openai":    ["OPENAI_API_KEY"],
    "kimi":      ["MOONSHOT_API_KEY"],
    "deepseek":  ["DEEPSEEK_API_KEY"],
    "ollama":    ["OLLAMA_BASE_URL"],
}
ALL_PROVIDER_KEYS = {k for keys in PROVIDER_ENV.values() for k in keys}

# One-line "what belongs here" for the common doc types (README + docs/<type>/.gitkeep).
DOC_TYPE_HINTS = {
    "knowledge": "Stable product facts: overview, stakeholders, feature status, metrics, ways of working",
    "specs": "What a feature should do and why",
    "decisions": "One record per decision: what, why, and what was rejected",
    "meeting-notes": "Notes or recordings, named `YYYY-MM-DD-topic.md`",
    "research": "Research, analysis, PDFs and briefs",
    "runbooks": "Step-by-step operational how-tos",
}


def log(msg): print(f"[pb] {msg}")
def die(msg): print(f"[pb] ERROR: {msg}", file=sys.stderr); sys.exit(1)


def load_config(hub: Path) -> dict:
    cfg = hub / "brain.config.json"
    if not cfg.exists():
        die(f"no brain.config.json in {hub} — is this a hub? (run brainify to create one)")
    try:
        return json.loads(cfg.read_text(encoding="utf-8-sig"))
    except json.JSONDecodeError as e:
        die(f"brain.config.json is not valid JSON: {e}")


def have(tool: str) -> bool:
    return shutil.which(tool) is not None


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


def safe_git_pull(path: Path, label: str, dry: bool):
    """Fast-forward pull a working tree — but only when it's safe to do so, so a developer's
    uncommitted work is never disturbed."""
    if not (path / ".git").exists():
        log(f"{label}: skipped pull (not a git repo)")
        return
    up = subprocess.run(["git", "-C", str(path), "rev-parse", "--abbrev-ref",
                         "--symbolic-full-name", "@{u}"], capture_output=True, text=True)
    if up.returncode != 0:
        log(f"{label}: skipped pull (no upstream/remote configured)")
        return
    dirty = subprocess.run(["git", "-C", str(path), "status", "--porcelain"],
                           capture_output=True, text=True).stdout.strip()
    if dirty:
        log(f"{label}: skipped pull (uncommitted changes — your work is left untouched)")
        return
    branch = subprocess.run(["git", "-C", str(path), "rev-parse", "--abbrev-ref", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    if dry:
        log(f"{label}: fast-forward pull ({branch})")
        return
    # --ff-only so a diverged branch fails cleanly instead of creating a merge commit.
    # A diverged branch is a normal developer state, not an error, so skip it gracefully.
    r = subprocess.run(["git", "-C", str(path), "pull", "--ff-only", "--quiet"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        log(f"{label}: fast-forward pull ({branch})")
    else:
        log(f"{label}: skipped pull (branch '{branch}' has diverged from upstream — "
            "your work is left untouched; reconcile with git when ready)")


def repos_dir(hub: Path, cfg: dict) -> Path:
    name = cfg.get("workspace", {}).get("repos_dir", "repos")
    return hub / name


def maybe_switch_branch(path: Path, branch: str, label: str, dry: bool):
    """Check out `branch` in an existing clone — but only when the tree is clean, so a
    developer's uncommitted work is never disturbed. A no-op if already on `branch`."""
    current = subprocess.run(["git", "-C", str(path), "rev-parse", "--abbrev-ref", "HEAD"],
                             capture_output=True, text=True).stdout.strip()
    if current == branch:
        return
    dirty = subprocess.run(["git", "-C", str(path), "status", "--porcelain"],
                           capture_output=True, text=True).stdout.strip()
    if dirty:
        log(f"{label}: on '{current}', config wants '{branch}' — kept '{current}' "
            "(uncommitted changes; switch yourself with git when ready)")
        return
    log(f"{label}: switching '{current}' → '{branch}' (config branch)")
    if not dry:
        r = subprocess.run(["git", "-C", str(path), "switch", branch],
                           capture_output=True, text=True)
        if r.returncode != 0:
            log(f"{label}: could not switch to '{branch}' (kept '{current}'): {r.stderr.strip()}")


def pull_repos(rdir: Path, repos: list, dry: bool, do_pull: bool):
    """Clone each app repo into repos/<id> as a FULL working clone, so developers can work
    in it directly inside the hub (and the graph is built over the live code). Existing clones
    are pulled only when safe (clean tree, fast-forward), never disturbing local work.

    Per repo in brain.config.json:
      "branch": "develop"  — clone that branch; on an existing clean clone, switch to it
      "pull": false        — never pull this clone (still cloned once if missing)"""
    if not dry:
        rdir.mkdir(parents=True, exist_ok=True)
    for r in repos:
        rid = r.get("id")
        if not rid:
            die(f"each repo needs an 'id' (got {r})")
        url = r.get("url")
        if not url:
            die(f"repo '{rid}' needs a 'url' to clone. Develop inside the hub's repos/{rid} folder.")
        dest = rdir / rid
        branch = r.get("branch")
        repo_pull = do_pull and r.get("pull", True)
        label = f"{rdir.name}/{rid}"
        if (dest / ".git").exists():
            if branch:
                maybe_switch_branch(dest, branch, label, dry)
            if repo_pull:
                safe_git_pull(dest, label, dry)
            elif not r.get("pull", True):
                log(f"{label}: present (pull disabled in config)")
            else:
                log(f"{label}: present (pull skipped)")
        else:
            on = f" (branch {branch})" if branch else ""
            log(f"clone {label} ({url}){on} — full working clone you can develop in")
            if not dry:
                cmd = ["git", "clone", "--quiet"]
                if branch:
                    cmd += ["--branch", branch]
                run(cmd + [url, str(dest)])


def ensure_exclusions(hub: Path, rdir: Path, out: Path, repos: list, dry: bool):
    """Keep the clones + the graph output out of Git — but WITHOUT a tracked .gitignore for
    repos/, because graphify honors .gitignore and would then skip the repos. We use:
      - .git/info/exclude  (local, untracked) so Git ignores repos/, graph/, and graphify-out/
      - .gitignore          (tracked) for graphify's AST cache (safe: it is graphify's own
                            output, never a source input, so graphify ignoring it is fine)
      - .graphifyignore     so graphify skips its own output, and — when a repo declares "src" —
        skips that repo's non-source top-level entries so the graph focuses on the source.
    """
    repos_name = rdir.name
    out_name = out.relative_to(hub).as_posix().rstrip("/")

    # 1) Git: local exclude (does not affect graphify, which reads .gitignore files)
    git_dir = hub / ".git"
    if git_dir.exists():
        excl = git_dir / "info" / "exclude"
        existing = excl.read_text(encoding="utf-8").splitlines() if excl.exists() else []
        wanted = [f"/{repos_name}/", f"/{out_name}/", "/graphify-out/"]
        add = [w for w in wanted if w not in existing]
        if add:
            log(f"git: excluding {', '.join(w.strip('/') for w in add)} from commits (.git/info/exclude)")
            if not dry:
                excl.parent.mkdir(parents=True, exist_ok=True)
                excl.write_text("\n".join(existing + add).rstrip("\n") + "\n", encoding="utf-8")

    # 2) .gitignore: graphify's internal AST cache and temporary work dirs.
    #    repos/ is intentionally NOT listed here — it stays in .git/info/exclude so graphify
    #    can still read the clones. graphify-out/ IS safe here: it is graphify's own output.
    gitignore = hub / ".gitignore"
    gi_marker = "graphify-out/cache/"
    existing_gi = gitignore.read_text(encoding="utf-8") if gitignore.exists() else ""
    if gi_marker not in existing_gi:
        block = (
            "\n# graphify-out/ — graphify AST parse cache (regenerable, can reach 200 MB+)\n"
            "graphify-out/cache/\n"
            "graphify-out/manifest.json\n"
            "graphify-out/.graphify_labels.json\n"
            "graphify-out/.graphify_root\n"
            "\n# Temporary work directory used during brainify runs\n"
            ".work/\n"
        )
        log("git: writing graphify-out/ cache and .work/ exclusions to .gitignore")
        if not dry:
            with open(gitignore, "a", encoding="utf-8") as f:
                f.write(block)

    # 2b) .gitignore: personal Claude settings hold tokens — a personal global gitignore
    #     doesn't protect teammates, so the hub's tracked .gitignore must cover it.
    local_settings = ".claude/settings.local.json"
    if local_settings not in (gitignore.read_text(encoding="utf-8") if gitignore.exists() else ""):
        log(f"git: ignoring {local_settings} in .gitignore (personal tokens, never committed)")
        if not dry:
            with open(gitignore, "a", encoding="utf-8") as f:
                f.write(f"\n# Personal Claude settings and tokens — never commit\n{local_settings}\n")

    # 3) graphify: skip the generated output; keep the repos in; focus each repo on its "src".
    gfi = hub / ".graphifyignore"
    wanted_lines = [
        "# Managed by Product Brain (pb sync). Edits here are overwritten — change brain.config.json instead.",
        f"{out_name}/",        # don't graph the generated map
        "graphify-out/",       # don't graph graphify's own AST cache
        f"!{repos_name}/",     # do graph the pulled apps even if Git ignores them
    ]
    for r in repos:
        rid = r.get("id")
        src_list = r.get("src") or ["."]
        if not rid or "." in src_list:
            continue  # no scoping → graph the whole repo
        repo_path = rdir / rid
        if not repo_path.exists():
            continue
        keep = {s.strip("/").split("/")[0] for s in src_list}   # top-level dirs to keep
        extras = sorted(e.name for e in repo_path.iterdir()
                        if e.name != ".git" and e.name not in keep)
        if extras:
            wanted_lines.append(f"# {rid}: graph only {', '.join(sorted(keep))}")
            wanted_lines += [f"{repos_name}/{rid}/{name}" for name in extras]

    if not gfi.exists() or gfi.read_text(encoding="utf-8").splitlines() != wanted_lines:
        log(f"graphify: writing .graphifyignore (skip {out_name}/, focus repos on their src)")
        if not dry:
            gfi.write_text("\n".join(wanted_lines) + "\n", encoding="utf-8")


def ensure_doc_folders(hub: Path, cfg: dict, dry: bool):
    """Every registered doc type gets docs/<type>/ with a .gitkeep, so the folder exists in
    every clone even before its first document."""
    for dtype in cfg.get("doc_types", []):
        keep = hub / "docs" / dtype / ".gitkeep"
        if keep.exists():
            continue
        log(f"docs: creating docs/{dtype}/.gitkeep")
        if not dry:
            keep.parent.mkdir(parents=True, exist_ok=True)
            keep.write_text("", encoding="utf-8")


def hub_remote(hub: Path) -> str:
    out = subprocess.run(["git", "-C", str(hub), "remote", "get-url", "origin"],
                         capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def any_llm_key() -> bool:
    """True if any provider's key is set in the environment."""
    return any(os.environ.get(k) for k in ALL_PROVIDER_KEYS)


def code_only_mode(provider: str) -> bool:
    """A code-only graph is built when no provider is forced AND no LLM key is present:
    graphify still parses code locally (free), but docs/images get no semantic pass."""
    return (not provider or provider == "auto") and not any_llm_key()


def graphify_env(provider: str):
    """Return (env, label) for the chosen provider. 'auto' lets graphify decide."""
    env = os.environ.copy()
    if not provider or provider == "auto":
        if any_llm_key():
            return env, "auto-detected by graphify (set GEMINI_API_KEY to prefer Gemini)"
        return env, ("none — CODE-ONLY graph (no LLM key found; docs/images get no semantic "
                     "pass). Set GEMINI_API_KEY, or another provider key, to enable it.")
    provider = provider.lower()
    keys = PROVIDER_ENV.get(provider)
    if keys is None:
        die(f"unknown graph provider '{provider}'. Choose one of: {', '.join(sorted(PROVIDER_ENV))} or 'auto'.")
    if not any(env.get(k) for k in keys):
        die(f"provider '{provider}' selected but none of {keys} is set.\n"
            f"      Set it first, e.g.:  export {keys[0]}=your-key")
    # Remove other providers' keys so graphify's auto-detect lands on the chosen one.
    for k in ALL_PROVIDER_KEYS - set(keys):
        env.pop(k, None)
    return env, provider


def run_graphify(content_root: Path, out: Path, dry: bool, rebuild: bool, provider: str):
    cmd = ["graphify", str(content_root), "--out", str(out)]
    # graphify may place its AST cache at out/cache/ or at graphify-out/cache/ (its own default)
    cache_candidates = [out / "cache", content_root / "graphify-out" / "cache"]
    has_cache = any(c.exists() for c in cache_candidates)
    if dry:
        log("would run: " + " ".join(cmd))
        log(f"provider: {provider}")
        log("cache: would " + ("clear (full rebuild)" if rebuild else "reuse" if has_cache else "create"))
        return
    if not have("graphify"):
        die("graphify not found on PATH. Install it with:  pip install graphifyy\n"
            "      (or reinstall the Product Brain plugin / run bin/install-skill.sh, which "
            "sets graphify up for you).")
    env, label = graphify_env(provider)
    log(f"semantic extraction provider: {label}")
    # graphify >= 0.9.5x refuses a no-key run over changed docs unless told --code-only
    # (older versions don't know the flag, so only pass it when graphify advertises it).
    if code_only_mode(provider) and "--code-only" in subprocess.run(
            ["graphify", "--help"], capture_output=True, text=True, encoding="utf-8",
            errors="replace").stdout:
        cmd.append("--code-only")
    out.mkdir(parents=True, exist_ok=True)
    if rebuild:
        for cache in cache_candidates:
            if cache.exists():
                log(f"clearing graphify cache for a full rebuild… ({cache.relative_to(content_root)})")
                shutil.rmtree(cache, ignore_errors=True)
    elif has_cache:
        # graphify fingerprints each file by content hash; unchanged files are skipped.
        log("incremental build — reusing graphify cache (unchanged files are skipped)")
    run(cmd, env=env)


def graph_stats(out: Path) -> str:
    gj = out / "graph.json"
    if not gj.exists():
        return "graph.json not found (did graphify run?)"
    try:
        data = json.loads(gj.read_text(encoding="utf-8"))
        nodes = len(data.get("nodes", []))
        edges = len(data.get("links", data.get("edges", [])))
        return f"{nodes} nodes, {edges} edges"
    except Exception:
        return "graph.json present (could not parse stats)"


def write_report(hub: Path, cfg: dict, out: Path, dry: bool, code_only: bool = False):
    if dry:
        return
    now = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
    repos = ", ".join(r["id"] for r in cfg.get("repos", []))
    coverage = ("⚠️ **code-only** — no LLM key was set, so documents and images did not get a "
                "semantic pass. Set `GEMINI_API_KEY` (or another provider key) and re-run "
                "`pb sync` to include them.\n\n") if code_only else ""
    report = out / "sync-report.md"
    report.write_text(
        f"# Sync report\n\n"
        f"**Last sync:** {now}\n\n"
        f"**Repos:** {repos or '(none)'}\n\n"
        f"**Graph:** {graph_stats(out)}\n\n"
        f"{coverage}"
        f"_Run `pb sync` again after meaningful code or doc changes._\n",
        encoding="utf-8",
    )
    log(f"wrote {report.relative_to(hub)}")


def render_readme(cfg: dict, graph_name: str, hub: Path = None) -> str:
    """Interpolate the framework's hub-readme template with this hub's config.
    Byte-stable for unchanged config: repos are sorted, no timestamps."""
    tmpl_path = framework_root() / "templates" / "hub-readme-template.md"
    if not tmpl_path.exists():
        return ""
    repos = sorted(cfg.get("repos", []), key=lambda r: r.get("id", ""))
    if repos:
        rows = ["| Repo | Source | `src` dirs |", "|---|---|---|"]
        for r in repos:
            src = ", ".join(f"`{s}`" for s in r.get("src", ["."])) or "`.`"
            rows.append(f"| `{r.get('id','?')}` | {r.get('url','—')} | {src} |")
        rows.append("")
        rows.append("Each is a full working clone under `repos/<id>` — develop in it directly.")
        repos_table = "\n".join(rows)
    else:
        repos_table = "_No repos registered yet — add them to `brain.config.json`, then `pb sync`._"
    doc_rows = "\n".join(f"| `docs/{d}/` | {DOC_TYPE_HINTS.get(d, 'Team knowledge')} |"
                         for d in cfg.get("doc_types", [])) or "| `docs/<type>/` | _No doc types registered yet_ |"
    url = hub_remote(hub) if hub else ""
    host = url.split("@")[-1].split("//")[-1].split(":")[0].split("/")[0] if url else "your code host"
    name = url.rstrip("/").removesuffix(".git").rsplit("/", 1)[-1].rsplit(":", 1)[-1] if url else cfg.get("hub_name", "hub")
    return (tmpl_path.read_text(encoding="utf-8")
            .replace("{{HUB_URL}}", url or "<this-hub-url>")
            .replace("{{CODE_HOST}}", host)
            .replace("{{HUB_DIR}}", name)
            .replace("{{DOC_TYPE_ROWS}}", doc_rows)
            .replace("{{HUB_NAME}}", cfg.get("hub_name", "Product Brain hub"))
            .replace("{{REPOS_TABLE}}", repos_table)
            .replace("{{GRAPH}}", graph_name)
            .replace("{{VERSION}}", read_version()))


def _managed_block(text: str):
    s, e = text.find(README_START), text.find(README_END)
    if s == -1 or e == -1 or e < s:
        return None
    return text[s:e + len(README_END)]


def write_readme(hub: Path, cfg: dict, out: Path, dry: bool):
    """Generate the hub README on first sync, and keep its managed block current thereafter.
    - No README, or a git-host default boilerplate → write the full scaffold.
    - README with our managed markers → refresh only that block, leave the rest.
    - Hand-written README without markers → leave untouched (just hint how to opt in)."""
    graph_name = out.relative_to(hub).as_posix().rstrip("/") + "/graph.json"
    rendered = render_readme(cfg, graph_name, hub)
    if not rendered:
        return  # framework template not found (e.g. pb copied out of the repo)
    block = _managed_block(rendered)
    readme = hub / "README.md"
    existing = readme.read_text(encoding="utf-8") if readme.exists() else None

    if existing is None or any(sign in existing for sign in HOST_README_SIGNS):
        new, why = rendered, ("created README.md" if existing is None
                              else "replaced git-host default README.md")
    elif block and README_START in existing and README_END in existing:
        pre = existing[:existing.find(README_START)]
        post = existing[existing.find(README_END) + len(README_END):]
        new, why = pre + block + post, "refreshed README.md managed block"
    else:
        log("README.md looks hand-written — leaving it untouched. Add "
            f"{README_START} … {README_END} markers to let pb sync keep a section current.")
        return

    if new == existing:
        return  # byte-stable: unchanged config produces no diff, no noise commit
    if dry:
        log(f"would update README.md ({why.split(' ',1)[0]})")
        return
    readme.write_text(new, encoding="utf-8")
    log(why)


def cmd_sync(hub: Path, dry: bool, rebuild: bool, hub_pull: bool, repo_pull: bool, provider: str,
             readme: bool = True):
    cfg = load_config(hub)
    repos = cfg.get("repos", [])
    out = hub / cfg.get("graph", {}).get("out", "graph/")
    provider = provider or cfg.get("graph", {}).get("provider", "auto")
    log(f"hub: {hub}")
    log(f"{len(repos)} repo(s): {', '.join(r['id'] for r in repos) or '(none)'}")
    code_only = code_only_mode(provider)
    if code_only:
        # Not fatal: code parsing is local and free, so we build a useful (code-only) graph
        # and tell the user plainly rather than silently shipping a weaker result.
        log("NOTE: no LLM key found — building a CODE-ONLY graph (docs/images get no semantic "
            "pass). Set GEMINI_API_KEY (or another provider key) and re-run to include them.")
    if not dry:
        graphify_env(provider)  # validate an explicitly-chosen provider's key before slow work
    if not have("git"):
        die("git not found on PATH.")
    if hub_pull:
        safe_git_pull(hub, "hub pull", dry)
    rdir = repos_dir(hub, cfg)
    log(f"apps folder: {rdir.name}/ — full working clones; develop in them directly inside the hub")
    pull_repos(rdir, repos, dry, repo_pull)
    ensure_exclusions(hub, rdir, out, repos, dry)
    ensure_doc_folders(hub, cfg, dry)
    run_graphify(hub, out, dry, rebuild, provider)
    write_report(hub, cfg, out, dry, code_only)
    if readme:
        write_readme(hub, cfg, out, dry)
    log("done." if not dry else "dry-run complete (nothing written).")


def _same_remote(a: str, b: str) -> bool:
    norm = lambda u: u.strip().lower().rstrip("/").removesuffix(".git").split("@")[-1].split("//")[-1]
    return bool(a) and bool(b) and norm(a).endswith(norm(b).split("/", 1)[-1])


def cmd_adopt(hub: Path, path: str, rid: str, do_copy: bool, force: bool):
    """One-time migration: relocate an EXISTING local checkout into the hub's repos/ folder,
    preserving its git history, remote, branches, and uncommitted work. After this there's a
    single working copy (in the hub) — no drift. Default is to MOVE; --copy leaves the original
    in place (which then becomes a stale duplicate you should delete)."""
    cfg = load_config(hub)
    if not have("git"):
        die("git not found on PATH.")
    src = Path(path).expanduser()
    if not src.exists():
        die(f"path not found: {src}")
    src = src.resolve()
    if not (src / ".git").exists():
        die(f"{src} is not a git checkout (adopt expects a real repo with its history).")
    if src == hub or hub in src.parents:
        die("that path is already inside the hub.")

    rdir = repos_dir(hub, cfg)
    out = hub / cfg.get("graph", {}).get("out", "graph/")
    origin = subprocess.run(["git", "-C", str(src), "remote", "get-url", "origin"],
                            capture_output=True, text=True)
    origin_url = origin.stdout.strip() if origin.returncode == 0 else ""

    if not rid:
        for r in cfg.get("repos", []):
            if _same_remote(r.get("url", ""), origin_url):
                rid = r["id"]; break
        rid = rid or src.name
    dest = rdir / rid
    if dest.exists():
        if not force:
            die(f"{dest} already exists — remove it, pass --force to replace it, or choose a different --id.")
        log(f"removing existing {dest} (--force)")
        shutil.rmtree(dest)

    rdir.mkdir(parents=True, exist_ok=True)
    action = "copy" if do_copy else "move"
    log(f"{action} {src} → {dest}")
    log("  (preserving git history, remote, branches, and any uncommitted work)")
    if do_copy:
        shutil.copytree(src, dest, symlinks=True)
    else:
        shutil.move(str(src), str(dest))

    ids = [r.get("id") for r in cfg.get("repos", [])]
    if rid not in ids:
        cfg.setdefault("repos", []).append({"id": rid, "url": origin_url, "src": ["."]})
        (hub / "brain.config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
        log(f"registered '{rid}' in brain.config.json — set its \"src\" dirs (e.g. [\"app/\"]) if needed")
    elif origin_url:
        cfgd = next(r for r in cfg["repos"] if r.get("id") == rid)
        if cfgd.get("url") and not _same_remote(cfgd["url"], origin_url):
            log(f"  ! note: config url for '{rid}' differs from this checkout's origin ({origin_url})")

    ensure_exclusions(hub, rdir, out, cfg.get("repos", []), dry=False)
    log(f"done — develop in {dest} from now on. Run `pb sync` to (re)build the graph.")
    if do_copy:
        log(f"  reminder: your original at {src} is now a stale duplicate — delete it to avoid confusion.")


def framework_root() -> Path:
    return Path(__file__).resolve().parent.parent


def read_version() -> str:
    vf = framework_root() / "VERSION"
    return vf.read_text(encoding="utf-8").strip() if vf.exists() else "unknown"


def _skill_version(skill_dir: Path):
    f = skill_dir / "SKILL.md"
    if not f.exists():
        return None
    for line in f.read_text(encoding="utf-8").splitlines():
        if line.strip().lower().startswith("version:"):
            return line.split(":", 1)[1].strip()
    return "unversioned"


SHARED_PLUGINS = ("git-workflow@product-brain", "guardrails@product-brain")


def legacy_installs(hub: Path, home: Path = None, pb_on_path: str = None) -> list:
    """Leftovers from pre-plugin installs that hide the plugin's newer copy, plus hubs set up before
    shared plugins existed. Only meaningful when this pb runs from the plugin; a checkout install
    (bin/install-skill.sh) is the old copy by design."""
    root = framework_root()
    if "/.claude/plugins/" not in root.as_posix():
        return []
    home = home or Path.home()
    found = []
    for loc in (home / ".claude" / "skills" / "brainify", hub / ".claude" / "skills" / "brainify"):
        if loc.exists() and not loc.is_symlink():
            found.append(f"An old brainify skill copy ({_skill_version(loc)}) at {loc} shadows the "
                         f"plugin's brainify {read_version()}. Remove that folder, then /reload-plugins.")
    pb_on_path = pb_on_path if pb_on_path is not None else (shutil.which("pb") or "")
    # which() skips extensionless files on Windows, but Git Bash still runs an old ~/.local/bin/pb
    old_link = home / ".local" / "bin" / "pb"
    for cand in dict.fromkeys(c for c in (pb_on_path, str(old_link) if os.path.lexists(old_link) else "") if c):
        if Path(cand).resolve() != (root / "bin" / "pb").resolve():
            found.append(f"An old `pb` at {cand} -> {Path(cand).resolve()} can run instead of the plugin's. "
                         f"Remove that link (the plugin already puts pb on PATH).")
    settings = hub / ".claude" / "settings.json"
    if (hub / "brain.config.json").exists() and settings.exists():
        text = settings.read_text(encoding="utf-8-sig")
        missing = [p for p in SHARED_PLUGINS if p not in text]
        if missing:
            found.append(f"This hub was set up by an older version: {', '.join(missing)} not enabled in "
                         f".claude/settings.json. Say \"audit our setup\" to upgrade it.")
    return found


def cmd_version_hook() -> int:
    """Claude Code SessionStart hook: tell Claude about old installs so it can offer to clean them
    up. Silent when there are none; never fails a session."""
    try:
        found = legacy_installs(Path(os.environ.get("CLAUDE_PROJECT_DIR") or "."))
    except Exception:
        return 0
    if found:
        print("Product Brain found leftovers from an older version:\n"
              + "\n".join(f"  - {f}" for f in found)
              + "\nTell the user about these once, early, in plain words, and offer to fix them. "
                "Ask before deleting anything.")
    return 0


def report_installed_skill():
    root = framework_root()
    for f in legacy_installs(Path.cwd()):
        print(f"⚠️  {f}")
    if "/.claude/plugins/" in root.as_posix():
        return
    repo_v = _skill_version(root / "skills" / "brainify")
    locations = [(Path.home() / ".claude" / "skills" / "brainify", "personal"),
                 (Path.cwd() / ".claude" / "skills" / "brainify", "project")]
    found = False
    for loc, label in locations:
        if not loc.exists():
            continue
        found = True
        if loc.is_symlink():
            print(f"installed skill ({label}): linked to the repo — always current")
        else:
            iv = _skill_version(loc)
            if iv == repo_v:
                print(f"installed skill ({label}): {iv} — up to date")
            else:
                print(f"installed skill ({label}): {iv} — repo has {repo_v}; re-run bin/install-skill.sh")
    if not found:
        print("installed skill: not found in ~/.claude/skills or ./.claude/skills "
              "(run bin/install-skill.sh)")


def cmd_version(check: bool):
    root = framework_root()
    print(f"Product Brain {read_version()}")
    if (root / ".git").exists() and have("git"):
        sha = subprocess.run(["git", "-C", str(root), "log", "-1", "--format=%h (%cs)"],
                             capture_output=True, text=True).stdout.strip()
        if sha:
            print(f"commit: {sha}")
    report_installed_skill()
    if not check:
        print("Run `pb version --check` to see if a newer version exists upstream.")
        return
    if not ((root / ".git").exists() and have("git")):
        print("check: not a git checkout — can't compare with upstream.")
        return
    fetch = subprocess.run(["git", "-C", str(root), "fetch", "--quiet"], capture_output=True, text=True)
    if fetch.returncode != 0:
        print("check: couldn't reach the remote (offline or no access).")
        return
    up = subprocess.run(["git", "-C", str(root), "rev-parse", "--abbrev-ref",
                         "--symbolic-full-name", "@{u}"], capture_output=True, text=True)
    if up.returncode != 0:
        print("check: no upstream branch configured.")
        return
    behind = subprocess.run(["git", "-C", str(root), "rev-list", "--count", "HEAD..@{u}"],
                            capture_output=True, text=True).stdout.strip()
    ahead = subprocess.run(["git", "-C", str(root), "rev-list", "--count", "@{u}..HEAD"],
                           capture_output=True, text=True).stdout.strip()
    if behind and int(behind) > 0:
        print(f"⬇️  {behind} update(s) available upstream. Run: git -C {root} pull")
    elif ahead and int(ahead) > 0:
        print(f"✅ up to date (and {ahead} local commit(s) not yet pushed).")
    else:
        print("✅ up to date — you have the latest version.")


def cmd_find(hub: Path, terms: list, code_only: bool, limit: int, repo: str):
    """Search the built graph for code symbols matching a product term + its aliases.
    This is what powers graph-assisted vocabulary: don't guess code names — look them up.
    Pass --repo <id> to scope the search to one repo (e.g. backend-only questions)."""
    cfg = load_config(hub)
    out = hub / cfg.get("graph", {}).get("out", "graph/")
    gj = out / "graph.json"
    if not gj.exists():
        die("no graph yet — run `pb sync` first, then `pb find <term>`.")
    if repo:
        known = [r.get("id") for r in cfg.get("repos", [])]
        if repo not in known:
            die(f"unknown repo '{repo}'. Known: {', '.join(known) or '(none)'}")
    try:
        data = json.loads(gj.read_text(encoding="utf-8"))
    except Exception as e:
        die(f"couldn't read {gj}: {e}")
    q = [t.lower() for t in terms]
    results = []
    for n in data.get("nodes", []):
        label = str(n.get("label", n.get("id", "")))
        ft = str(n.get("file_type", ""))
        src = str(n.get("source_file", ""))
        if code_only and ft != "code":
            continue
        if repo and f"repos/{repo}/" not in src.replace("\\", "/"):
            continue
        hay = label.lower()
        score = 0
        for t in q:
            if not t:
                continue
            if t == hay:
                score += 4
            elif t in hay or hay in t:
                score += 3
            else:
                toks = [tok for tok in t.replace("-", " ").replace("_", " ").split() if tok]
                score += sum(1 for tok in toks if tok in hay)
        if score > 0:
            results.append((score, label, ft, str(n.get("source_file", ""))))
    if not results:
        print(f"no matches for: {', '.join(terms)}")
        return
    results.sort(key=lambda x: (-x[0], x[1]))
    scope = f" (scoped to repo: {repo})" if repo else ""
    print(f"Candidate code symbols for: {', '.join(terms)}{scope}")
    for score, label, ft, src in results[:limit]:
        tag = f" [{ft}]" if ft else ""
        loc = f"  — {src}" if src else ""
        print(f"  {label}{tag}{loc}")


def cmd_status(hub: Path):
    cfg = load_config(hub)
    out = hub / cfg.get("graph", {}).get("out", "graph/")
    print(f"Hub: {hub}")
    print(f"Repos: {', '.join(r['id'] for r in cfg.get('repos', [])) or '(none)'}")
    print(f"Doc types: {', '.join(cfg.get('doc_types', [])) or '(none)'}")
    for d in CORE_DOCS:
        mark = "ok" if (hub / d).exists() else ("absent" if d == "domains.md" else "MISSING")
        print(f"  {d}: {mark}")
    try:
        bad, notes = layout_report(hub, cfg)
        n = len(bad) + len(notes)
        print("Layout: ok" if not n else f"Layout: {n} problem(s) — run `pb check`")
    except (OSError, subprocess.CalledProcessError):
        print("Layout: not checked (needs git)")
    gj = out / "graph.json"
    if gj.exists():
        age = (dt.datetime.now() - dt.datetime.fromtimestamp(gj.stat().st_mtime)).days
        print(f"Graph: {graph_stats(out)} ({age}d old)")
    else:
        print("Graph: not built — run `pb sync`")


LAYOUT_HELP = """Where things go in a Product Brain hub:
  - team knowledge -> docs/<type>/, where <type> is registered in brain.config.json
    (registered: {types})
  - a new kind of doc -> add its type to doc_types in brain.config.json first; never a new
    top-level folder
  - scratch, command output, API/JSON dumps -> .work/ (git-ignored); put the finding in a doc
  - the top level holds only: {root},
    docs/, workflows/, templates/ (plus dot-files and the repos/graph folders)"""


def _config_doc_dirs(v) -> set:
    """The docs/<x>/ folders brain.config.json points a skill at (e.g. releases.out, roadmap.out)."""
    if isinstance(v, dict):
        v = list(v.values())
    if isinstance(v, list):
        return set().union(set(), *map(_config_doc_dirs, v))
    if isinstance(v, str) and v.startswith("docs/") and v.split("/")[1]:
        return {v.split("/")[1]}
    return set()


def layout_problems(cfg: dict, paths) -> list:
    """The hub-relative (POSIX) paths that sit outside the hub layout."""
    types = set(cfg.get("doc_types", [])) | _config_doc_dirs(cfg)
    design = cfg.get("design", {})
    dirs = ROOT_DIRS | {cfg.get("workspace", {}).get("repos_dir", "repos"),
                        cfg.get("graph", {}).get("out", "graph/").strip("/").split("/")[0],
                        design.get("build", "brand").strip("/").split("/")[0]}
    files = ROOT_FILES | {design.get("system", "DESIGN.md")}
    bad = []
    for p in paths:
        top, _, rest = p.partition("/")
        if top.startswith("."):
            continue  # tooling: .claude/, .mcp.json, .gitignore, .work/, …
        if not rest:
            ok = top in files
        elif top == "docs":
            kind, _, leaf = rest.partition("/")
            ok = bool(leaf) and kind in types
        else:
            ok = top in dirs
        if not ok:
            bad.append(p)
    return bad


def _porcelain_paths(raw: bytes) -> list:
    """New/changed paths from `git status --porcelain -z` (deletions skipped: they're leaving)."""
    entries, paths, i = raw.decode("utf-8", "replace").split("\0"), [], 0
    while i < len(entries):
        e = entries[i]
        i += 1
        if len(e) < 4:
            continue
        xy, path = e[:2], e[3:]
        if "R" in xy or "C" in xy:
            i += 1  # the next entry is the rename/copy source
        if "D" not in xy:
            paths.append(path)
    return paths


def git_paths(hub: Path, changed_only: bool = False) -> list:
    """Every non-ignored file in the hub (tracked + new), or only the new/changed ones."""
    if changed_only:
        cmd = ["git", "-C", str(hub), "status", "--porcelain", "-z", "--untracked-files=all"]
        return _porcelain_paths(subprocess.run(cmd, capture_output=True, check=True).stdout)
    cmd = ["git", "-C", str(hub), "ls-files", "-z", "--cached", "--others", "--exclude-standard"]
    out = subprocess.run(cmd, capture_output=True, check=True).stdout.decode("utf-8", "replace")
    return [p for p in out.split("\0") if p and (hub / p).exists()]  # skip deleted-not-staged


def _grouped(bad: list) -> list:
    """Collapse a stray folder's files into one line: 'Stuff/ (7 files)'."""
    groups = {}
    for p in bad:
        parts = p.split("/")
        if len(parts) == 1 or (parts[0] == "docs" and len(parts) == 2):
            key = p
        else:
            key = "/".join(parts[:2 if parts[0] == "docs" else 1]) + "/"
        groups[key] = groups.get(key, 0) + 1
    return [k if not k.endswith("/") else f"{k} ({n} file{'s' * (n > 1)})"
            for k, n in sorted(groups.items(), key=lambda kv: kv[0].lower())]


def layout_help(cfg: dict) -> str:
    return LAYOUT_HELP.format(types=", ".join(cfg.get("doc_types", [])) or "none",
                              root=", ".join(sorted(ROOT_FILES)))


def layout_report(hub: Path, cfg: dict):
    """(files outside the layout, other notes) for the whole hub."""
    types = cfg.get("doc_types", [])
    notes = [f"required doc type '{t}' is not registered in brain.config.json"
             for t in REQUIRED_DOC_TYPES if t not in types]
    notes += [f"docs/{t}/ is registered but missing" for t in types if not (hub / "docs" / t).is_dir()]
    return layout_problems(cfg, git_paths(hub)), notes


def cmd_check(hub: Path) -> int:
    cfg = load_config(hub)
    try:
        bad, notes = layout_report(hub, cfg)
    except (OSError, subprocess.CalledProcessError):
        die("pb check needs git on PATH and the hub to be a git repo")
    if not bad and not notes:
        print("Layout: ok — everything is where the hub layout expects it.")
        return 0
    if bad:
        print("Outside the hub layout:")
        for line in _grouped(bad):
            print(f"  - {line}")
    for n in notes:
        print(f"Note: {n}")
    print("\n" + layout_help(cfg))
    return 1


def cmd_check_hook() -> int:
    """Claude Code Stop hook: when Claude has just left files outside the layout, tell it to move
    them before it finishes (exit 2 feeds stderr back to Claude). Checks only new/changed files, so
    old clutter doesn't nag every reply (`pb check` reports that). Never blocks twice in a row, and
    is a no-op outside a hub or when anything goes wrong — a hygiene check must not break a session."""
    try:
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
        event = json.loads(sys.stdin.read() or "{}")
        if event.get("stop_hook_active"):
            return 0
        hub = Path(os.environ.get("CLAUDE_PROJECT_DIR") or event.get("cwd") or ".")
        cfg_path = hub / "brain.config.json"
        if not cfg_path.exists():
            return 0
        cfg = json.loads(cfg_path.read_text(encoding="utf-8-sig"))
        bad = layout_problems(cfg, git_paths(hub, changed_only=True))
    except Exception:
        return 0
    if not bad:
        return 0
    lines = "\n".join(f"  - {line}" for line in _grouped(bad))
    print(f"Product Brain layout check: these new or changed files are outside the hub layout:\n"
          f"{lines}\n\n{layout_help(cfg)}\n\n"
          "Before finishing, move each one where it belongs (git mv if tracked), or into .work/ if "
          "it is scratch. If a file looks like the user's own and you're unsure where it goes, ask "
          "them instead of moving or deleting it. Re-check with `pb check`.", file=sys.stderr)
    return 2


def selftest():
    cfg = {"doc_types": ["knowledge", "specs"]}
    paths = ["CLAUDE.md", ".mcp.json", ".claude/settings.json", "docs/specs/a.md",
             "docs/other/b.md", "docs/stray.md", "dump.json", "Stuff/x.md", "Stuff/y.md",
             "workflows/pm.md", "graph/graph.json", "repos/api/x.py"]
    bad = layout_problems(cfg, paths)
    assert bad == ["docs/other/b.md", "docs/stray.md", "dump.json", "Stuff/x.md", "Stuff/y.md"], bad
    assert _grouped(bad) == ["docs/other/ (1 file)", "docs/stray.md", "dump.json",
                             "Stuff/ (2 files)"], _grouped(bad)
    custom = {"workspace": {"repos_dir": "apps"}, "graph": {"out": "map/"}}
    assert layout_problems(custom, ["apps/x.py", "map/graph.json", "repos/x.py"]) == ["repos/x.py"]
    # the brand build + the docs/ folders that artifact skills write to via brain.config.json
    artifacts = {"doc_types": [], "releases": {"out": "docs/releases"},
                 "dashboard": {"inputs": [{"path": "docs/okrs/tracker.html"}]}}
    assert layout_problems(artifacts, ["DESIGN.md", "brand/brand.css", "docs/releases/1.0.md",
                                       "docs/okrs/tracker.html", "docs/misc/x.md"]) == ["docs/misc/x.md"]
    raw = b"?? new.txt\0R  new.md\0old.md\0 D gone.md\0 M CLAUDE.md\0"
    assert _porcelain_paths(raw) == ["new.txt", "new.md", "CLAUDE.md"], _porcelain_paths(raw)
    print("pb check selftest: ok")


def main():
    for stream in (sys.stdout, sys.stderr):  # Windows consoles default to a legacy code page
        stream.reconfigure(encoding="utf-8", errors="replace")
    p = argparse.ArgumentParser(prog="pb", description="Product Brain hub CLI")
    p.add_argument("--hub", default=".", help="path to the hub repo (default: current dir)")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("sync", help="pull repos and (re)build the graph (incremental by default)")
    s.add_argument("--dry-run", action="store_true", help="show the plan without writing or running graphify")
    s.add_argument("--rebuild", action="store_true", help="clear the graphify cache and rebuild everything from scratch")
    s.add_argument("--no-hub-pull", action="store_true", help="don't pull the hub's own latest changes first")
    s.add_argument("--no-repo-pull", action="store_true", help="don't pull the app working clones (leave them exactly as they are)")
    s.add_argument("--no-readme", action="store_true", help="don't create or refresh the hub's README.md")
    s.add_argument("--provider", help="LLM provider for graphify's doc/image pass: "
                   "gemini | claude | openai | kimi | deepseek | ollama | auto (overrides brain.config.json)")
    sub.add_parser("status", help="show hub health at a glance")
    c = sub.add_parser("check", help="list files outside the hub layout (also the Claude Code Stop hook)")
    c.add_argument("--hook", action="store_true",
                   help="Stop-hook mode: read the hook event on stdin, check only new/changed files")
    c.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    a = sub.add_parser("adopt", help="move an existing local checkout into the hub (one-time, keeps git history + uncommitted work)")
    a.add_argument("path", help="path to your existing local checkout")
    a.add_argument("--id", help="repo id to use under repos/ (default: matched from config, else folder name)")
    a.add_argument("--copy", action="store_true", help="copy instead of move (leaves a stale duplicate behind)")
    a.add_argument("--force", action="store_true", help="replace repos/<id> if it already exists")
    f = sub.add_parser("find", help="search the graph for code symbols matching a term (powers vocabulary)")
    f.add_argument("terms", nargs="+", help="the product term and/or its aliases, e.g. find session booking appointment")
    f.add_argument("--code-only", action="store_true", help="only return code symbols (skip docs)")
    f.add_argument("--repo", help="scope the search to one repo id (e.g. backend-api)")
    f.add_argument("--limit", type=int, default=15, help="max results (default 15)")
    v = sub.add_parser("version", help="show the Product Brain version (and check for updates)")
    v.add_argument("--check", action="store_true", help="fetch and report whether a newer version exists upstream")
    v.add_argument("--hook", action="store_true", help=argparse.SUPPRESS)
    args = p.parse_args()

    if args.cmd == "version":
        if args.hook:
            sys.exit(cmd_version_hook())
        cmd_version(args.check)
        return
    if args.cmd == "check" and (args.hook or args.selftest):
        sys.exit(cmd_check_hook() if args.hook else selftest())

    hub = Path(args.hub).resolve()
    if not hub.exists():
        die(f"hub path does not exist: {hub}")
    try:
        if args.cmd == "sync":
            cmd_sync(hub, args.dry_run, args.rebuild, not args.no_hub_pull, not args.no_repo_pull,
                     args.provider, not args.no_readme)
        elif args.cmd == "status":
            cmd_status(hub)
        elif args.cmd == "check":
            sys.exit(cmd_check(hub))
        elif args.cmd == "adopt":
            cmd_adopt(hub, args.path, args.id, args.copy, args.force)
        elif args.cmd == "find":
            cmd_find(hub, args.terms, args.code_only, args.limit, args.repo)
    except subprocess.CalledProcessError as e:
        die(f"command failed: {' '.join(str(c) for c in e.cmd)}")


if __name__ == "__main__":
    main()
